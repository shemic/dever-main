# 文本下标按 Unicode 标量；解析失败和越界保留 null，不自动改成零或空字符串。

main() (
  cleaned: Text,
  character: Text?,
  slice: Text?,
  pieces: List<Text>,
  joined: Text,
  parsed: Int?,
  invalid: Int?,
  exact: Decimal?,
  rounded: Decimal,
  utf8: Text,
  invalid_utf8: dever.bytes.DecodeResult,
  invalid_byte: dever.bytes.BufferResult
) pure {
  cleaned = text.lower(text.trim(" Dever "))
  character = text.at("a中😀", 2)
  slice = text.slice("a中😀", 1, 3)
  pieces = text.split("a,,b", ",")
  joined = text.join(pieces, "|")
  parsed = int.parse("42")
  invalid = int.parse("forty-two")
  exact = decimal.parse("1.25")
  rounded = decimal.round(2.345, 2)
  utf8 = dever.bytes.to_text(dever.bytes.from_text("你好"))
  invalid_utf8 = result(dever.bytes.to_text(dever.bytes.from_ints([255])))
  invalid_byte = result(dever.bytes.from_ints([256]))
}
